<a class="box @(Selected ? "is-sel" : "")" href="@navUrl" title="@Title">
    <span class="box-corner tl"></span>
    <span class="box-corner br"></span>
    <div class="box-main">
        <div class="box-head">
            <span class="box-ico">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M14.7 6.3a4 4 0 0 0 5.1 5.1l1.4-1.4a4 4 0 0 0-5.1-5.1Z" />
                    <path d="M9.3 17.7a4 4 0 0 1-5.1-5.1l1.4-1.4a4 4 0 0 1 5.1 5.1Z" />
                    <path d="M8.5 15.5 15.5 8.5" />
                </svg>
            </span>
            <h3>@MarkedTitle</h3>
        </div>
        <p class="box-desc">@(string.IsNullOrWhiteSpace(Desc) ? "点击进入工具" : Desc)</p>
        <div class="box-foot">
            <span class="box-path">/@navUrl</span>
            <span class="box-go">进入 →</span>
        </div>
    </div>
</a>

@code {
    [Parameter]
    public string Desc { get; set; } = "";

    [Parameter]
    public string navUrl { get; set; } = "counter";

    [Parameter]
    public string Title { get; set; } = "tool";

    /// <summary>搜索命中位置掩码（长度与 Title 对齐），为 true 的字符会被 &lt;mark&gt; 包裹。</summary>
    [Parameter]
    public bool[]? Mark { get; set; }

    /// <summary>键盘上下键选中的卡片。</summary>
    [Parameter]
    public bool Selected { get; set; }

    /// <summary>
    /// 把标题按掩码切成「普通文本 / 高亮片段」交替的块，
    /// 避免逐字符渲染产生一堆相邻的 mark 元素。
    /// </summary>
    private RenderFragment MarkedTitle => builder =>
    {
        var text = Title ?? "";
        var mask = Mark;
        int seq = 0;
        int i = 0;

        while (i < text.Length)
        {
            bool on = mask is not null && i < mask.Length && mask[i];

            int j = i;
            while (j < text.Length && ((mask is not null && j < mask.Length && mask[j]) == on))
            {
                j++;
            }

            var chunk = text.Substring(i, j - i);
            if (on)
            {
                builder.OpenElement(seq++, "mark");
                builder.AddContent(seq++, chunk);
                builder.CloseElement();
            }
            else
            {
                builder.AddContent(seq++, chunk);
            }

            i = j;
        }
    };
}
