<a class="box @(Selected ? "is-sel" : "")" href="@navUrl" title="@Title">
    <span class="box-corner tl"></span>
    <span class="box-corner br"></span>
    @if (FavChanged.HasDelegate)
    {
        <button type="button" class="box-fav @(Faved ? "on" : "")"
                title="@(Faved ? "移除收藏" : "收藏此工具")"
                aria-label="@(Faved ? "移除收藏" : "收藏此工具")"
                @onclick="OnFavClick"
                @onclick:stopPropagation="true"
                @onclick:preventDefault="true">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 2.6l2.9 5.9 6.5.9-4.7 4.6 1.1 6.5-5.8-3-5.8 3 1.1-6.5L2.6 9.4l6.5-.9z" />
            </svg>
        </button>
    }
    <div class="box-main">
        <div class="box-head">
            <span class="box-ico">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M14.7 6.3a4 4 0 0 0 5.1 5.1l1.4-1.4a4 4 0 0 0-5.1-5.1Z" />
                    <path d="M9.3 17.7a4 4 0 0 1-5.1-5.1l1.4-1.4a4 4 0 0 1 5.1 5.1Z" />
                    <path d="M8.5 15.5 15.5 8.5" />
                </svg>
            </span>
            <h3>@MarkedTitle</h3>
            @if (!string.IsNullOrEmpty(NetNote))
            {
                <span class="box-tag tag-net" title="@NetNote">第三方 API</span>
            }
        </div>
        <p class="box-desc">@(string.IsNullOrWhiteSpace(Desc) ? "点击进入工具" : Desc)</p>
        <div class="box-foot">
            <span class="box-path">/@navUrl</span>
            <span class="box-go">进入 →</span>
        </div>
    </div>
</a>

@code {
    /// <summary>该工具是否已被收藏（控制星标高亮）。</summary>
    [Parameter]
    public bool Faved { get; set; }

    /// <summary>点击星标时触发，参数为期望的新状态：true=收藏，false=取消收藏。</summary>
    [Parameter]
    public EventCallback<bool> FavChanged { get; set; }

    private Task OnFavClick() => FavChanged.InvokeAsync(!Faved);

    [Parameter]
    public string Desc { get; set; } = "";

    [Parameter]
    public string navUrl { get; set; } = "counter";

    [Parameter]
    public string Title { get; set; } = "tool";

    /// <summary>搜索命中位置掩码（长度与 Title 对齐），为 true 的字符会被 &lt;mark&gt; 包裹。</summary>
    [Parameter]
    public bool[]? Mark { get; set; }

    /// <summary>键盘上下键选中的卡片。</summary>
    [Parameter]
    public bool Selected { get; set; }

    /// <summary>
    /// 非空表示这个工具会向第三方发起网络请求，卡片上会打「第三方 API」角标；
    /// 该字符串同时作为角标的 tooltip，用来说明具体请求了谁。
    /// </summary>
    [Parameter]
    public string? NetNote { get; set; }

    /// <summary>
    /// 把标题按掩码切成「普通文本 / 高亮片段」交替的块，
    /// 避免逐字符渲染产生一堆相邻的 mark 元素。
    /// </summary>
    private RenderFragment MarkedTitle => builder =>
    {
        var text = Title ?? "";
        var mask = Mark;
        int seq = 0;
        int i = 0;

        while (i < text.Length)
        {
            bool on = mask is not null && i < mask.Length && mask[i];

            int j = i;
            while (j < text.Length && ((mask is not null && j < mask.Length && mask[j]) == on))
            {
                j++;
            }

            var chunk = text.Substring(i, j - i);
            if (on)
            {
                builder.OpenElement(seq++, "mark");
                builder.AddContent(seq++, chunk);
                builder.CloseElement();
            }
            else
            {
                builder.AddContent(seq++, chunk);
            }

            i = j;
        }
    };
}
