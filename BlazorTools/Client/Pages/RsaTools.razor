@page "/rsaTools"
@inject IJSRuntime JS

<PageTitle>RSA 加密解密 · BlazorTools</PageTitle>

<h3>Rsa加密解密</h3>

<p class="page-note">
    在浏览器本地生成 RSA 密钥对并做加解密（PKCS#1 v1.5 填充）。
    密钥与明文都<b>不出本机</b>；2048 位及以上更安全，但生成耗时会明显变长。
</p>

<div class="panel form-panel">
    <div class="panel-head">
        <span class="panel-title">密钥生成</span>
        <span class="panel-sub">公私钥 PEM 格式</span>
    </div>

    <div class="form-grid">
        <div class="field">
            <label for="rsa-len">密钥长度 (bit)</label>
            <input id="rsa-len" class="form-control" type="number" min="512" step="256"
                   autocomplete="off" @bind="keyLen" @bind:event="oninput" />
        </div>
    </div>

    <div class="chip-row">
        <span class="chip-row-label">常用长度</span>
        @foreach (var len in KeyLens)
        {
            <button type="button" class="chip-btn @(keyLen == len ? "is-on" : null)"
                    title="@KeyHint(len)"
                    @onclick="() => keyLen = len">@len</button>
        }
    </div>

    <div class="btn-row">
        <button type="button" class="btn btn-primary" @onclick="GenKey" disabled="@busy">
            @(busy ? "生成中…" : "生成密钥对")
        </button>
    </div>

    @if (busy)
    {
        <div class="stat-strip"><span class="spin">正在生成 @keyLen 位密钥</span></div>
    }
</div>

@if (error is not null)
{
    <div class="alert-box">
        <span class="alert-box-ico" aria-hidden="true">!</span>
        <span>@error</span>
    </div>
}

@if (!string.IsNullOrEmpty(pubKey) || !string.IsNullOrEmpty(prvKey))
{
    <div class="panel">
        <div class="panel-head">
            <span class="panel-title">密钥对 Key pair</span>
        </div>

        <div class="io-pair">
            <div class="pane">
                <div class="pane-head">
                    <span class="pane-title">公钥 Public key</span>
                    <span class="pane-tools">
                        <button type="button" class="copy-btn" title="复制公钥" aria-label="复制公钥"
                                @onclick='async () => await Copy(pubKey, "pub")'>@Mark("pub")</button>
                    </span>
                </div>
                <div class="pane-body">
                    <textarea @bind="pubKey" @bind:event="oninput" placeholder="生成后可手动粘贴外部公钥"></textarea>
                </div>
            </div>

            <div class="io-arrow" aria-hidden="true">⇅</div>

            <div class="pane">
                <div class="pane-head">
                    <span class="pane-title">私钥 Private key</span>
                    <span class="pane-tools">
                        <button type="button" class="copy-btn" title="复制私钥" aria-label="复制私钥"
                                @onclick='async () => await Copy(prvKey, "prv")'>@Mark("prv")</button>
                    </span>
                </div>
                <div class="pane-body">
                    <textarea @bind="prvKey" @bind:event="oninput" placeholder="生成后可手动粘贴外部私钥（PKCS#8）"></textarea>
                </div>
            </div>
        </div>
    </div>
}

<div class="panel">
    <div class="panel-head">
        <span class="panel-title">加解密 Encrypt / Decrypt</span>
        <span class="panel-sub">结果统一输出到下方</span>
    </div>

    <div class="form-grid">
        <div class="field">
            <label for="rsa-plain">明文 Plain text</label>
            <input id="rsa-plain" class="form-control" type="text" autocomplete="off"
                   placeholder="要加密的内容" @bind="plainText" @bind:event="oninput" />
            <div class="btn-row">
                <button type="button" class="btn btn-primary" disabled="@busy" @onclick="Encrypt">用公钥加密 →</button>
            </div>
        </div>

        <div class="field">
            <label for="rsa-cipher">密文 Cipher (Base64)</label>
            <input id="rsa-cipher" class="form-control" type="text" autocomplete="off" spellcheck="false"
                   placeholder="要解密的内容" @bind="cipherText" @bind:event="oninput" />
            <div class="btn-row">
                <button type="button" class="btn btn-primary" disabled="@busy" @onclick="Decrypt">← 用私钥解密</button>
            </div>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(result))
{
    <div class="panel">
        <div class="panel-head">
            <span class="panel-title">结果 Result</span>
            <span class="panel-tools">
                <button type="button" class="copy-btn" title="复制结果" aria-label="复制结果"
                        @onclick='async () => await Copy(result, "res")'>@Mark("res")</button>
            </span>
        </div>

        <div class="out-box v-rsa">@result</div>

        <div class="btn-row">
            <button type="button" class="btn" @onclick='() => { cipherText = result; }'>填到待解密区</button>
            <button type="button" class="btn" @onclick='() => { plainText = result; }'>填到待加密区</button>
            <button type="button" class="btn" @onclick="ClearResult">清空结果</button>
        </div>

        <div class="stat-strip">
            <span class="stat-chip">结果 <b>@Len(result)</b> 字符</span>
        </div>
    </div>
}

@code {
    private static readonly int[] KeyLens = { 1024, 2048, 3072, 4096 };

    private string pubKey = "";
    private string prvKey = "";
    private string plainText = "";
    private string cipherText = "";
    private string result = "";
    private int keyLen = 2048;
    private bool busy = false;
    private string? error = null;
    private string copied = "";

    private string Mark(string key) => copied == key ? "✓" : "⧉";

    private static int Len(string? s) => s?.Length ?? 0;

    private static string KeyHint(int len) => len switch
    {
        1024 => "1024 位：生成快，已不推荐用于新系统",
        2048 => "2048 位：当前通用下限",
        3072 => "3072 位：更长的安全寿命",
        4096 => "4096 位：安全但生成最慢（可能要十几秒）",
        _ => len + " 位",
    };

    static string rsaScriptInit()
    {
        return $@"
function rsaDecrypt(prvKey, text){{
    var key = KEYUTIL.getKey(prvKey);
    var maxLength = ((key.n.bitLength()+7)>>3)*2;
    var enc = b64tohex(text);
    //var dec = KJUR.crypto.Cipher.decrypt(enc, key);
    var dec='';
    var rexStr="".{{1,"" + maxLength  + ""}}"";
    var rex =new RegExp(rexStr, 'g');
    var subStrArray = enc.match(rex);
    
    if(subStrArray){{
        subStrArray.forEach(function(entry) {{
            var tmp = KJUR.crypto.Cipher.decrypt(entry, key);
            dec += tmp;
		}});
	}}
    return dec;
}}

function rsaEncrypt (pubKey, text)
{{
    var key = KEYUTIL.getKey(pubKey);
    //var enc = KJUR.crypto.Cipher.encrypt(text, key);
    //return hextob64(enc);
    var maxLength = ((key.n.bitLength()+7)>>3)-11;

    var subStr='', encryptedString = '';
	var subStart = 0, subEnd=0;
	var bitLen=0, tmpPoint=0;
    for(var i = 0, len = text.length; i < len; i++){{
        var charCode = text.charCodeAt(i);
        if(charCode <= 0x007f) {{bitLen += 1;
				}}else if(charCode <= 0x07ff){{bitLen += 2;
				}}else if(charCode <= 0xffff){{bitLen += 3;
				}}else{{bitLen += 4;
				}}
        if(bitLen>maxLength){{subStr = text.substring(subStart, subEnd)
					encryptedString += KJUR.crypto.Cipher.encrypt(subStr, key);
					subStart=subEnd;
					bitLen=bitLen-tmpPoint;
				}}else{{subEnd = i;
					tmpPoint=bitLen;
				}}
}}
    subStr=text.substring(subStart,len)
	encryptedString += KJUR.crypto.Cipher.encrypt(subStr, key);
    return hextob64(encryptedString);  
}}
function rsaCreatekey(len)
{{
    var kp = KEYUTIL.generateKeypair(""RSA"", len);
    var prvKey = kp.prvKeyObj;
    var pub = KEYUTIL.getPEM(kp.pubKeyObj);
    var prv = KEYUTIL.getPEM(kp.prvKeyObj, 'PKCS8PRV');
    var keyArray = new Array();
    keyArray.push(prv);
    keyArray.push(pub);
    return keyArray;
}}
function copyToClipboard(eleID){{
    var text = document.getElementById(eleID);
    text.select();


    if (document.execCommand('copy')) 
    {{document.execCommand('copy');
         console.log('复制成功');
    }}
}}

";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        if (firstRender)
        {
            string scriptContent;
            using (var stream = this.GetType().Assembly.GetManifestResourceStream(this.GetType().Assembly.GetName().Name + ".Pages.RsaTools.razor.js"))
            {
                using (var sr = new System.IO.StreamReader(stream!))
                    scriptContent = await sr.ReadToEndAsync();
            }

            await JS.InvokeVoidAsync("eval", scriptContent);
            await JS.InvokeVoidAsync("eval", rsaScriptInit());
        }
    }

    private async Task GenKey()
    {
        error = null;
        copied = "";
        busy = true;
        StateHasChanged();

        try
        {
            int len = keyLen;
            if (len < 512) len = 512;

            var keys = await JS.InvokeAsync<string[]>("rsaCreatekey", len);
            if (keys is { Length: > 1 })
            {
                prvKey = keys[0] ?? "";
                pubKey = keys[1] ?? "";
            }
            else
            {
                error = "密钥生成失败：JS 端没有返回密钥对。";
            }
        }
        catch (Exception ex)
        {
            error = "密钥生成失败：" + ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task Encrypt()
    {
        error = null;
        copied = "";
        busy = true;

        try
        {
            result = await JS.InvokeAsync<string>("rsaEncrypt", pubKey, plainText) ?? "";
        }
        catch (Exception ex)
        {
            error = "加密失败（检查公钥是否有效、明文是否为空）：" + ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task Decrypt()
    {
        error = null;
        copied = "";
        busy = true;

        try
        {
            result = await JS.InvokeAsync<string>("rsaDecrypt", prvKey, cipherText) ?? "";
        }
        catch (Exception ex)
        {
            error = "解密失败（检查私钥是否匹配、密文是否完整）：" + ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private void ClearResult()
    {
        result = "";
        copied = "";
        error = null;
    }

    private async Task Copy(string value, string key)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", value ?? "");
            copied = key;
        }
        catch
        {
            copied = "";
        }
    }
}
