@page "/base64encoder"
@using System.Text
@inject IJSRuntime JS

<PageTitle>Base64 编码/解码 · BlazorTools</PageTitle>

<h3>Base64 编码/解码</h3>

<p class="page-note">
    文本与 Base64 互转，文本侧统一按 <code>UTF-8</code> 编码成字节。
    解码时会自动忽略换行与空格，粘贴带缩进的 Base64 也不会报错。
</p>

<div class="panel">
    <div class="panel-head">
        <span class="panel-title">编解码器</span>
        <span class="panel-sub">UTF-8 文本 ⇄ Base64</span>
        <span class="panel-tools">
            <button type="button" class="chip-btn" @onclick="Swap" title="把右侧结果搬到左侧">交换两侧</button>
        </span>
    </div>

    <div class="io-pair">
        <div class="pane">
            <div class="pane-head">
                <span class="pane-title">原文 Plain text</span>
                <span class="pane-tools">
                    <button type="button" class="copy-btn" title="复制原文" aria-label="复制原文"
                            @onclick='async () => await Copy(plain, "plain")'>@Mark("plain")</button>
                </span>
            </div>
            <div class="pane-body">
                <textarea placeholder="例如 Hello BlazorTools · 中文也可以"
                          @bind="plain" @bind:event="oninput"></textarea>
            </div>
        </div>

        <div class="io-arrow" aria-hidden="true">⇄</div>

        <div class="pane">
            <div class="pane-head">
                <span class="pane-title">Base64</span>
                <span class="pane-tools">
                    <button type="button" class="copy-btn" title="复制 Base64" aria-label="复制 Base64"
                            @onclick='async () => await Copy(b64, "b64")'>@Mark("b64")</button>
                </span>
            </div>
            <div class="pane-body">
                <textarea placeholder="例如 SGVsbG8gQmxhem9yVG9vbHM="
                          @bind="b64" @bind:event="oninput"></textarea>
            </div>
        </div>
    </div>

    <div class="chip-row">
        <span class="chip-row-label">字母表</span>
        <button type="button" class="chip-btn @(urlSafe ? null : "is-on")"
                title="标准 Base64：+/ 填充 ="
                @onclick='() => SetUrlSafe(false)'>标准 +/</button>
        <button type="button" class="chip-btn @(urlSafe ? "is-on" : null)"
                title="URL / 文件名安全：-_ ，去掉尾部填充"
                @onclick='() => SetUrlSafe(true)'>URL 安全 -_</button>
    </div>

    <div class="btn-row">
        <button type="button" class="btn btn-primary" @onclick="Encode">编码 →</button>
        <button type="button" class="btn" @onclick="Decode">← 解码</button>
        <button type="button" class="btn" @onclick="Clear">清空</button>
    </div>

    <div class="stat-strip">
        <span class="stat-chip">原文 <b>@CharCount</b> 字符</span>
        <span class="stat-chip"><b>@ByteCount</b> 字节 (UTF-8)</span>
        <span class="stat-chip">Base64 <b>@Len(b64)</b> 字符</span>
    </div>
</div>

@if (error is not null)
{
    <div class="alert-box">
        <span class="alert-box-ico" aria-hidden="true">!</span>
        <span>@error</span>
    </div>
}

@code {
    private string plain = "";
    private string b64 = "";
    private bool urlSafe = false;
    private string? error = null;
    private string copied = "";

    private string Mark(string key) => copied == key ? "✓" : "⧉";

    private int CharCount => plain?.Length ?? 0;

    private int ByteCount => string.IsNullOrEmpty(plain) ? 0 : Encoding.UTF8.GetByteCount(plain);

    private static int Len(string? s) => s?.Length ?? 0;

    private static string ToB64(byte[] bytes, bool safe) =>
        safe
            ? Convert.ToBase64String(bytes).TrimEnd('=').Replace('+', '-').Replace('/', '_')
            : Convert.ToBase64String(bytes);

    private static byte[] FromB64(string text, bool safe)
    {
        string s = text.Trim();

        // 容忍粘贴时带入的换行 / 空格 / 缩进
        s = string.Concat(s.Where(c => !char.IsWhiteSpace(c)));

        if (safe)
        {
            s = s.Replace('-', '+').Replace('_', '/');
            // URL 安全变体通常不带填充，补回来才能被 Convert 接受
            int rem = s.Length % 4;
            if (rem == 2) s += "==";
            else if (rem == 3) s += "=";
            else if (rem != 0) throw new FormatException("长度不合法：Base64 字符串去掉填充后长度模 4 只能是 0 / 2 / 3。");
        }

        return Convert.FromBase64String(s);
    }

    private void SetUrlSafe(bool value)
    {
        if (urlSafe == value) return;
        urlSafe = value;

        // 切换字母表后，已有的编码结果要跟着换算，否则会误导
        Reset();
        if (b64.Length > 0 && plain.Length > 0)
        {
            try
            {
                b64 = ToB64(Encoding.UTF8.GetBytes(plain), urlSafe);
            }
            catch
            {
                error = "按新的字母表换算失败，请重新点一次「编码」。";
            }
        }
    }

    private void Encode()
    {
        Reset();
        if (plain.Length == 0)
        {
            error = "左侧原文为空，没有可编码的内容。";
            return;
        }

        b64 = ToB64(Encoding.UTF8.GetBytes(plain), urlSafe);
    }

    private void Decode()
    {
        Reset();
        if (b64.Length == 0)
        {
            error = "右侧为空，没有可解码的内容。";
            return;
        }

        try
        {
            plain = Encoding.UTF8.GetString(FromB64(b64, urlSafe));
        }
        catch (Exception ex)
        {
            error = "不是合法的 Base64 字符串：" + ex.Message;
        }
    }

    private void Swap()
    {
        Reset();
        (plain, b64) = (b64, plain);
    }

    private void Clear()
    {
        plain = "";
        b64 = "";
        Reset();
    }

    private void Reset()
    {
        error = null;
        copied = "";
    }

    private async Task Copy(string value, string key)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", value ?? "");
            copied = key;
        }
        catch
        {
            // 非安全上下文 / 无剪贴板权限时静默降级
            copied = "";
        }
    }
}
