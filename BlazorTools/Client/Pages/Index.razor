    <BoxPanel navUrl="rsatools" Title="RSA加密解密" Desc="浏览器本地生成密钥并加解密" />
    <BoxPanel navUrl="urlencoder" Title="Url编码/解码" Desc="URL Encode / Decode" />
    <BoxPanel navUrl="base64encoder" Title="Base64编码/解码" Desc="文本与 Base64 互转" />
    <BoxPanel navUrl="jsonstrformate" Title="Json格式化" Desc="JSON 压缩 / 美化 / 中文转义" />
    <BoxPanel navUrl="dateconvert" Title="DateConvert" Desc="时间戳与日期时间互转" />
    <BoxPanel navUrl="numbertochinese" Title="数字转大写" Desc="金额数字转中文大写" />
