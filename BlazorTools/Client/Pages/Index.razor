@page "/"
@using BlazorTools.Client.Components

<PageTitle>BlazorTools · 在线工具箱</PageTitle>

<section class="hero">
    <div class="hero-tag">// RUNTIME · WEBASSEMBLY · LOCAL COMPUTE</div>
    <div class="hero-title">BLAZOR<i>//</i>TOOLS</div>
    <p class="hero-sub">17 个纯前端小工具 · 全部计算在你的浏览器内完成，数据不出本机。</p>
