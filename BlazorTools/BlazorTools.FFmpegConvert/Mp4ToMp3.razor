@page "/mp4tomp3"
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>MP4 转 MP3 · BlazorTools</PageTitle>

<h3>MP4 转 MP3</h3>

<p class="page-note">
    基于 ffmpeg.wasm 在浏览器内提取视频音轨并转码为 MP3，文件全程不上传服务器；
    转码核心已内置于本站静态资源，首次使用约需下载 5 MB 的 Brotli 压缩包（ffmpeg-core.wasm.br），浏览器侧自动解压。
</p>

<div class="panel form-panel">
    <div class="panel-head">
        <span class="panel-title">选择文件 File</span>
        <span class="panel-sub">视频容器 · 单次最大 2 GB</span>
    </div>

    <div class="file-pick">
        <InputFile OnChange="fileLoad" accept=".mp4,video/mp4" disabled="@busy" />
        @if (busy)
        {
            <span class="spin">转换中</span>
        }
    </div>

    @if (!string.IsNullOrEmpty(url))
    {
        <div class="cv-meta">
            <span class="cv-meta-k">已选择</span>
            <span class="cv-meta-v" title="@fileName">@fileName</span>
            <span class="cv-meta-size">@fileSizeStr</span>
        </div>
    }
</div>

<div class="panel form-panel">
    <div class="panel-head">
        <span class="panel-title">源文件预览 Source</span>
        <span class="panel-sub">选完文件即可播放</span>
    </div>

    <div class="preview-box">
        @if (!string.IsNullOrEmpty(url))
        {
            <video controls src="@url" />
        }
        else
        {
            <span class="preview-empty">Select an MP4 file</span>
        }
    </div>
</div>

@if (errorText is not null)
{
    <div class="alert-box">
        <span class="alert-box-ico" aria-hidden="true">!</span>
        <span>@errorText</span>
    </div>
}

<div class="panel form-panel">
    <div class="panel-head">
        <span class="panel-title">转换 Convert</span>
        <span class="panel-sub">FFmpeg 转码 · 浏览器本地执行</span>
    </div>

    <div class="btn-row">
        <button type="button" class="btn btn-primary" disabled="@(string.IsNullOrEmpty(url) || busy)" @onclick="Convert">
            @(coreLoaded ? "转换为 MP3" : "加载核心并转换为 MP3")
        </button>
    </div>

    @if (busy)
    {
        <div class="cv-progress">
            <div class="cv-progress-bar"><i style="@ProgressStyle"></i></div>
            <span class="cv-progress-text">@statusText</span>
        </div>
    }
    else if (!string.IsNullOrEmpty(statusText))
    {
        <p class="cv-status">@statusText</p>
    }

    @if (!string.IsNullOrEmpty(url2))
    {
        <div class="cv-result">
            <span class="cv-meta-k">输出结果 Output</span>
            <audio controls src="@url2" />
            <div class="btn-row">
                <a class="btn btn-primary" href="@url2" download="output.mp3">下载 output.mp3</a>
            </div>
        </div>
    }
</div>

<p class="page-note">
    Powered by <a href="https://github.com/ffmpegwasm/ffmpeg.wasm" target="_blank" rel="noopener">ffmpeg.wasm</a>（核心已本地化，无需外网）
</p>

@code {
    private const long MaxBytes = 2L * 1024 * 1024 * 1024;
    private const string ModulePath = "./_content/BlazorTools.FFmpegConvert/js/ffmpeg-convert.js";

    private IJSObjectReference? module;
    private DotNetObjectReference<Mp4ToMp3>? dotnetRef;
    private string url = "", url2 = "", statusText = "";
    private string? errorText;
    private double progressRatio;
    private string fileSizeStr = "";
    private string fileName = "myFile.mp4", contentType = "video/mp4";
    private bool busy;
    private bool coreLoaded;

    private string ProgressStyle => $"width:{progressRatio * 100:F0}%";

    protected override async Task OnInitializedAsync()
    {
        dotnetRef = DotNetObjectReference.Create(this);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            module = await JS.InvokeAsync<IJSObjectReference>("import", ModulePath);
        }
    }

    private async Task fileLoad(InputFileChangeEventArgs v)
    {
        try
        {
            var file = v.GetMultipleFiles()[0];
            fileName = string.IsNullOrWhiteSpace(file.Name) ? "myFile.mp4" : file.Name;
            contentType = string.IsNullOrWhiteSpace(file.ContentType) ? "video/mp4" : file.ContentType;

            var bytes = new byte[file.Size];
            await using var stream = file.OpenReadStream(MaxBytes);
            await stream.ReadExactlyAsync(bytes);

            // 字节经 DotNetStreamReference 高效传入 JS（ArrayBuffer，无 JSON 序列化），
            // 在 JS 侧缓存供转换复用，同时生成预览 Blob URL
            url = await module!.InvokeAsync<string>("setFile",
                fileName, new DotNetStreamReference(new MemoryStream(bytes)), contentType);
            url2 = "";
            errorText = null;
            progressRatio = 0;
            fileSizeStr = $"{file.Size / 1024.0 / 1024.0:F1} MB";
            statusText = "文件已就绪，点击上方按钮开始转换";
        }
        catch (Exception ex)
        {
            statusText = "";
            errorText = "读取文件失败：" + ex.Message;
        }
        finally
        {
            StateHasChanged();
        }
    }

    private async Task Convert()
    {
        if (module is null || busy) return;
        busy = true;
        progressRatio = 0;
        try
        {
            if (!coreLoaded)
            {
                statusText = "正在下载并解压 FFmpeg 核心（约 5 MB，已内置于本站）…";
                errorText = null;
                StateHasChanged();
                coreLoaded = await module.InvokeAsync<bool>("load", dotnetRef);
                if (!coreLoaded)
                {
                    statusText = "";
                    errorText = "FFmpeg 核心加载失败，请刷新页面重试";
                    return;
                }
            }

            statusText = "转换中…";
            errorText = null;
            StateHasChanged();
            url2 = await module.InvokeAsync<string>("convert",
                new[] { "-i", fileName, "output.mp3" }, fileName, "output.mp3", "audio/mpeg");
            statusText = "转换完成";
        }
        catch (Exception ex)
        {
            statusText = "";
            errorText = "转换失败：" + ex.Message;
        }
        finally
        {
            busy = false;
            StateHasChanged();
        }
    }

    [JSInvokable]
    public Task OnProgress(double ratio)
    {
        progressRatio = Math.Min(1, Math.Max(0, ratio));
        statusText = progressRatio < 1 ? $"转换中… {(progressRatio * 100):F0}%" : "输出文件生成中…";
        try { StateHasChanged(); } catch (ObjectDisposedException) { }
        return Task.CompletedTask;
    }

    [JSInvokable]
    public Task OnLog(string message)
    {
        Console.WriteLine(message);
        return Task.CompletedTask;
    }

    public async ValueTask DisposeAsync()
    {
        dotnetRef?.Dispose();
        if (module is not null)
        {
            try { await module.DisposeAsync(); } catch { }
        }
    }
}
